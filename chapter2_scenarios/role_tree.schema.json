{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/cadm/asymmetric-role-tree.schema.json",
  "title": "Role-conditioned asymmetric object-event decomposition",
  "type": "object",
  "required": ["case_id", "run_id", "role_id", "role_label", "primary_dimension", "object_nodes", "object_edges", "event_nodes", "causal_edges"],
  "properties": {
    "case_id": {"const": "UA-EDO-02"},
    "run_id": {"type": "string", "minLength": 1},
    "role_id": {"type": "string", "minLength": 1},
    "role_label": {"type": "string", "minLength": 1},
    "primary_dimension": {"$ref": "#/$defs/domain"},
    "object_nodes": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/object_node"}},
    "object_edges": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/object_edge"}},
    "event_nodes": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/event_node"}},
    "causal_edges": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/causal_edge"}},
    "uncertainties": {"type": "array", "items": {"type": "string", "minLength": 5}}
  },
  "$defs": {
    "domain": {"enum": ["identity_personnel", "enterprise_it", "it_ot_reachability", "ot_process", "continuity_recovery", "external_dependencies"]},
    "object_class": {"enum": ["organization", "domain_container", "person_role", "identity", "service", "system", "interface", "communication_channel", "power_resource", "external_relationship", "response_resource"]},
    "initial_attributes": {
      "type": "object",
      "required": ["availability", "trust", "connectivity"],
      "properties": {
        "availability": {"type": "string", "minLength": 1},
        "trust": {"type": "string", "minLength": 1},
        "connectivity": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "object_node": {
      "type": "object",
      "required": ["id", "label", "node_type", "object_class", "domain", "initial_attributes"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "label": {"type": "string", "minLength": 3},
        "node_type": {"enum": ["state_root", "domain", "object", "interface", "dependency", "resource"]},
        "object_class": {"$ref": "#/$defs/object_class"},
        "domain": {"$ref": "#/$defs/domain"},
        "initial_attributes": {"$ref": "#/$defs/initial_attributes"}
      },
      "additionalProperties": false
    },
    "object_edge": {
      "type": "object",
      "required": ["parent", "child", "relation", "rationale"],
      "properties": {
        "parent": {"type": "string"},
        "child": {"type": "string"},
        "relation": {"enum": ["consists_of", "contains", "has_interface", "has_dependency"]},
        "rationale": {"type": "string", "minLength": 10}
      },
      "additionalProperties": false
    },
    "event_role": {
      "type": "object",
      "required": ["role", "object_class", "scope", "mandatory", "required_attributes"],
      "properties": {
        "role": {"enum": ["actor", "target", "channel", "resource"]},
        "object_class": {"$ref": "#/$defs/object_class"},
        "scope": {"enum": ["initial_state", "external"]},
        "mandatory": {"type": "boolean"},
        "required_attributes": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "event_node": {
      "type": "object",
      "required": ["id", "label", "node_type", "event_class", "domain", "required_roles", "predecessor_logic", "observable_result"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "label": {"type": "string", "minLength": 5},
        "node_type": {"enum": ["target_event", "causal_event"]},
        "event_class": {"enum": ["contact", "identity_change", "access", "control", "operational_action", "operational_effect", "recovery_impairment", "response_requirement"]},
        "domain": {"$ref": "#/$defs/domain"},
        "required_roles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event_role"}},
        "predecessor_logic": {"enum": ["single", "all_of", "any_of"]},
        "observable_result": {"type": "string", "minLength": 5}
      },
      "additionalProperties": false
    },
    "causal_edge": {
      "type": "object",
      "required": ["cause", "effect", "relation", "rationale"],
      "properties": {
        "cause": {"type": "string"},
        "effect": {"type": "string"},
        "relation": {"enum": ["enables", "causes", "contributes_to"]},
        "logic_group": {"type": ["string", "null"]},
        "rationale": {"type": "string", "minLength": 10}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
